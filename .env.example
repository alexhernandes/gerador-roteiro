# Chave da xAI — https://console.x.ai/
XAI_API_KEY=sua_chave_xai_aqui

# Modelo padrão (Grok 4.3 direto da xAI)
XAI_MODEL=grok-4.3

# none = mais rápido e barato para JSON estruturado | low | medium | high
XAI_REASONING_EFFORT=none

# Defaults da interface
DEFAULT_LANGUAGE=Português (Brasil)
DEFAULT_ASPECT_RATIO=9:16
DEFAULT_THEME=Livre — crie uma história viral com drama e humor

# Universo/preset visual dos personagens
DEFAULT_UNIVERSE=frutinhas
UNIVERSE_OPTIONS=frutinhas,carros,predios_falantes,humanos_desenhados

# Configuração do vídeo/roteiro
VIDEO_RESOLUTION=480p
SCENE_DURATION_SECONDS=10
TOTAL_SCENES=7
TOTAL_DURATION_SECONDS=70

# Execução do agente de vídeo
# true = agente pergunta antes de avançar para o próximo passo
AGENT_CONFIRM_BETWEEN_STEPS=true

# Quantos vídeos o agente pode fazer antes de pedir/seguir para o próximo passo
AGENT_VIDEOS_PER_STEP=1

# Abrir automaticamente a pasta output/<sessao> ao finalizar com sucesso
OPEN_OUTPUT_FOLDER_ON_FINISH=true
